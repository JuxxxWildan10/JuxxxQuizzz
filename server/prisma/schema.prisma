generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  password          String?
  name              String
  role              String            @default("SISWA")
  avatar            String?
  xp                Int               @default(0)
  level             Int               @default(1)
  rank              String            @default("BRONZE")
  googleId          String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  subscriptionTier  String            @default("FREE")
  teachingClasses   Class[]           @relation("TeacherClasses")
  quizzesCreated    Quiz[]            @relation("QuizCreator")
  sessions          Session[]
  tournamentEntries TournamentEntry[]
  transactions      Transaction[]
  achievements      UserAchievement[]
  enrolledClasses   Class[]           @relation("StudentClasses")
}

model Class {
  id        String   @id @default(uuid())
  name      String
  schoolId  String?
  teacherId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teacher   User     @relation("TeacherClasses", fields: [teacherId], references: [id])
  students  User[]   @relation("StudentClasses")
}

model Quiz {
  id           String        @id @default(uuid())
  title        String
  description  String?
  creatorId    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  isPublic     Boolean       @default(true)
  mode         String        @default("BOSS_BATTLE")
  roomCode     String?       @unique
  price        Int           @default(0)
  isPremium    Boolean       @default(false)
  questions    Question[]
  creator      User          @relation("QuizCreator", fields: [creatorId], references: [id])
  rooms        Room[]
  transactions Transaction[]
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  quizId    String?
  amount    Int
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  quiz      Quiz?    @relation(fields: [quizId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Question {
  id        String   @id @default(uuid())
  quizId    String
  text      String
  image     String?
  timeLimit Int      @default(30)
  points    Int      @default(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  answers   Answer[]
  quiz      Quiz     @relation(fields: [quizId], references: [id])
}

model Answer {
  id         String   @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean
  question   Question @relation(fields: [questionId], references: [id])
}

model Room {
  id        String    @id @default(uuid())
  code      String    @unique
  quizId    String
  mode      String    @default("EXAM")
  status    String    @default("WAITING")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  quiz      Quiz      @relation(fields: [quizId], references: [id])
  sessions  Session[]
}

model Session {
  id          String     @id @default(uuid())
  userId      String
  roomId      String
  score       Int        @default(0)
  combo       Int        @default(0)
  joinedAt    DateTime   @default(now())
  completedAt DateTime?
  analytics   Analytics?
  room        Room       @relation(fields: [roomId], references: [id])
  user        User       @relation(fields: [userId], references: [id])
}

model Achievement {
  id          String            @id @default(uuid())
  title       String
  description String
  icon        String
  condition   String
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
}

model Tournament {
  id          String            @id @default(uuid())
  title       String
  description String
  startDate   DateTime
  endDate     DateTime
  status      String            @default("UPCOMING")
  entries     TournamentEntry[]
}

model TournamentEntry {
  id           String     @id @default(uuid())
  tournamentId String
  userId       String
  score        Int        @default(0)
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
}

model Analytics {
  id               String  @id @default(uuid())
  sessionId        String  @unique
  correctCount     Int     @default(0)
  wrongCount       Int     @default(0)
  avgTime          Float   @default(0)
  cheatingAttempts Int     @default(0)
  session          Session @relation(fields: [sessionId], references: [id])
}

model Leaderboard {
  id        String   @id @default(uuid())
  userId    String
  score     Int
  period    String
  updatedAt DateTime @updatedAt
}
